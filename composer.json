{
    "name": "coolms/dtmpl",
    "description": "DTMPL template engine: a designer-facing template language with a lexer, parser, AST and runtime, plus a widget seam for host-supplied components",
    "type": "library",
    "license": "MIT",
    "keywords": ["template", "template-engine", "dtmpl", "parser", "ast", "cms"],
    "authors": [
        {
            "name": "Dmitry Popov"
        }
    ],
    "require": {
        "php": "^8.5",
        "psr/cache": "^2.0 || ^3.0",
        "symfony/property-access": "^8.0",
        "symfony/translation-contracts": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "CoolMS\\Dtmpl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoolMS\\Dtmpl\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
